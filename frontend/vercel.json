{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "https://vaggio-api.onrender.com/api/:caminho*"
    },
    {
      "source": "/:caminho*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:caminho*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
