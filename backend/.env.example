# Copie para .env e ajuste. O backend le este arquivo via python-decouple.

SECRET_KEY=troque-isso
DJANGO_SETTINGS_MODULE=config.settings.development

# Origens liberadas no CORS (o front do Vite roda na 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token pessoal do GitHub (escopo publico basta).
# Sem ele: 60 requisicoes/hora. Com ele: 5000.
# Gere em https://github.com/settings/tokens
GITHUB_TOKEN=

# Endpoint do portal publico da Gupy. Se a coleta falhar, confira o endereco
# atual no DevTools (instrucoes em apps/collectors/sources/gupy.py).
GUPY_API=https://employability-portal.gupy.io/api/v1/jobs

# Google AI Studio (aistudio.google.com), usado pelo `manage.py pitch` para
# gerar o "Apresente-se" da Gupy. Free tier, sem cartao.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# PostgreSQL (opcional). Preencha DB_NAME para usar Postgres no lugar do SQLite.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── E-mail ────────────────────────────────────────────────────────────────
# Sem EMAIL_HOST o Django imprime a mensagem no console em vez de enviar, que
# basta para desenvolver: o link aparece no terminal do runserver.
#
# No Brevo, EMAIL_HOST_USER NAO e o e-mail da conta: e o login proprio de SMTP,
# na mesma pagina onde a chave e gerada. Autenticar com o e-mail da conta
# devolve "535 5.7.8 Authentication failed".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Tem de ser um remetente verificado no provedor, senao o envio e recusado.
DEFAULT_FROM_EMAIL=Vaggio <nao-responda@exemplo.dev>

# Base dos links mandados por e-mail (recuperacao de senha, convite, troca de
# e-mail). E o endereco do FRONT, nao o da API: quem clica cai numa tela.
# Em producao isto PRECISA ser o dominio real, senao todo link sai quebrado.
FRONTEND_URL=http://localhost:5173

# Prazo dos links de uso unico, em horas.
PRAZO_LINK_SENHA_HORAS=2
PRAZO_LINK_CONVITE_HORAS=72
PRAZO_LINK_EMAIL_HORAS=2

# ── Limite de tentativa ───────────────────────────────────────────────────
# Vale para as rotas publicas, que sao as unicas que respondem sem sessao.
THROTTLE_LOGIN=10/min
THROTTLE_RECUPERACAO=5/hour
THROTTLE_2FA=10/min
