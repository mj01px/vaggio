# Copie para .env e ajuste. O backend le este arquivo via python-decouple.

SECRET_KEY=troque-isso
DJANGO_SETTINGS_MODULE=config.settings.development

# Origens liberadas no CORS (o front do Vite roda na 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token pessoal do GitHub (escopo publico basta).
# Sem ele: 60 requisicoes/hora. Com ele: 5000.
# Gere em https://github.com/settings/tokens
GITHUB_TOKEN=

# Endpoint do portal publico da Gupy. Se a coleta falhar, confira o endereco
# atual no DevTools (instrucoes em apps/collectors/sources/gupy.py).
GUPY_API=https://employability-portal.gupy.io/api/v1/jobs

# Google AI Studio (aistudio.google.com), usado pelo `manage.py pitch` para
# gerar o "Apresente-se" da Gupy. Free tier, sem cartao.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# PostgreSQL (opcional). Preencha DB_NAME para usar Postgres no lugar do SQLite.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Ligue quando o Postgres estiver atras de um pooler em modo transaction, que e
# o caso do Supabase na porta 6543. Desliga prepared statement e conexao
# persistente: as duas coisas quebram ali, e o erro nao ajuda em nada
# ("prepared statement _pg3_0 already exists"). Na conexao direta (5432), deixe
# False, que e mais rapido.
DB_POOLER=False
# TLS. Gerenciado costuma exigir `require`; local nao usa nada.
DB_SSLMODE=

# ── E-mail ────────────────────────────────────────────────────────────────
# Sem EMAIL_HOST o Django imprime a mensagem no console em vez de enviar, que
# basta para desenvolver: o link aparece no terminal do runserver.
#
# No Brevo, EMAIL_HOST_USER NAO e o e-mail da conta: e o login proprio de SMTP,
# na mesma pagina onde a chave e gerada. Autenticar com o e-mail da conta
# devolve "535 5.7.8 Authentication failed".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Tem de ser um remetente verificado no provedor, senao o envio e recusado.
DEFAULT_FROM_EMAIL=Vaggio <nao-responda@exemplo.dev>

# Base dos links mandados por e-mail (recuperacao de senha, convite, troca de
# e-mail). E o endereco do FRONT, nao o da API: quem clica cai numa tela.
# Em producao isto PRECISA ser o dominio real, senao todo link sai quebrado.
FRONTEND_URL=http://localhost:5173

# Prazo dos links de uso unico, em horas.
PRAZO_LINK_SENHA_HORAS=2
PRAZO_LINK_CONVITE_HORAS=72
PRAZO_LINK_EMAIL_HORAS=2

# ── Limite de tentativa ───────────────────────────────────────────────────
# Os tres primeiros valem para as rotas publicas, que sao as unicas que
# respondem sem sessao. Os tres ultimos valem para quem ja entrou.
THROTTLE_LOGIN=10/min
THROTTLE_RECUPERACAO=5/hour
THROTTLE_2FA=10/min
# Teto geral por pessoa. Largo o suficiente para nunca esbarrar em uso humano.
THROTTLE_USER=3000/hour
# Gerar apresentacao chama o Gemini e leva uns 10 segundos; a coleta, uns 40.
THROTTLE_PITCH=30/hour
THROTTLE_COLETA=12/hour

# ── So em producao ────────────────────────────────────────────────────────
# Quantos saltos de proxy existem entre o cliente e o Django. E o que diz ao
# DRF ate onde confiar no X-Forwarded-For, que e a identidade que os limites
# acima usam. Errar para mais deixa o cliente escolher a propria identidade e
# os limites viram enfeite.
#   1  hospedagem com um proxy na frente (Render, Fly, Railway, Heroku)
#   2  o mesmo, com Cloudflare na frente dele
#   0  Django exposto direto
NUM_PROXIES=1

# Dominios que respondem, separados por virgula. No Render, o hostname do
# servico entra sozinho.
ALLOWED_HOSTS=

# Origens que o Django aceita em POST. Precisa do dominio do FRONT quando ele
# chega por outro endereco, que e o caso do rewrite da Vercel: o Origin que
# chega e o da Vercel e o Host e o do Render. Sem isto, todo POST da 403.
CSRF_TRUSTED_ORIGINS=

# Vazio quando o front chega pelo mesmo dominio (rewrite da Vercel, nginx).
# So preencha se o navegador for bater direto no endereco da API.
CORS_ALLOWED_ORIGINS=

# Onde fica a contagem do limite de tentativa. O padrao e em arquivo, que os
# workers do mesmo deploy compartilham. Com Redis a mao, aponte para ele.
CACHE_BACKEND=
CACHE_LOCATION=
